# ULTRON B2 ROS 2 Humble image for the Jetson Orin (arm64). STATUS: UNRUN (never built or tested).
#
# BASE_IMAGE is deliberately not defaulted to a guess: it must match the Orin's JetPack/L4T
# release (TO_VERIFY on the robot with `cat /etc/nv_tegra_release`). Candidates to evaluate:
#   dustynv/ros:humble-ros-base-l4t-r<L4T>   (community; tag per L4T release)
#   nvcr.io/nvidia/l4t-jetpack:r<L4T>        (+ ROS 2 Humble from packages.ros.org, Ubuntu 22.04 only)
# Build (on an arm64 host or with buildx/qemu):
#   docker buildx build --platform linux/arm64 --build-arg BASE_IMAGE=<verified tag> \
#     -f ros2_ws/docker/Dockerfile.orin -t ultron-b2-orin:humble ros2_ws/docker
# Hardware use of this image still requires the full-system simulation gate, a responsible
# operator, verified RC priority, an independent watchdog and a functional physical E-stop.
ARG BASE_IMAGE
FROM ${BASE_IMAGE:?set --build-arg BASE_IMAGE to the image verified against the Orin JetPack}

ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Runtime subset (no Gazebo/MuJoCo/rviz). Package availability on the chosen base is TO_VERIFY;
# dustynv images may build ROS from source under /opt/ros/humble/install instead of apt.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3-pip python3-numpy python3-yaml python3-colcon-common-extensions python3-vcstool \
      ros-humble-navigation2 ros-humble-nav2-bringup ros-humble-slam-toolbox \
      ros-humble-twist-mux ros-humble-pointcloud-to-laserscan \
      ros-humble-foxglove-bridge ros-humble-domain-bridge ros-humble-rosbag2-storage-mcap \
      ros-humble-robot-state-publisher ros-humble-xacro ros-humble-tf2-ros \
      ros-humble-rmw-cyclonedds-cpp ros-humble-diagnostic-msgs ros-humble-rosidl-generator-dds-idl \
      ros-humble-mola ros-humble-mola-lidar-odometry \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir "numpy<2" kiss-icp==1.2.3

# Robot profile: domain/NIC are set at run time by the operator (cyclonedds_robot.xml has NIC
# TO_VERIFY). No default ROS_DOMAIN_ID is baked in; the bringup preflight enforces the mode table.
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CMD ["bash"]
