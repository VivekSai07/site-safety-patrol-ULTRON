# ULTRON B2 ROS 2 Humble development image (x86_64).
# Build: docker build -f ros2_ws/docker/Dockerfile.dev -t ultron-b2-dev:humble ros2_ws/docker
# Simulation/replay development only. No hardware drivers are exercised here.
FROM ros:humble-ros-base

ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Required packages: the build fails if any of these is unavailable.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git curl ca-certificates \
      python3-pip python3-pytest python3-numpy python3-yaml \
      python3-colcon-common-extensions python3-vcstool python3-rosdep \
      ros-humble-navigation2 ros-humble-nav2-bringup \
      ros-humble-slam-toolbox \
      ros-humble-twist-mux ros-humble-teleop-twist-joy ros-humble-teleop-twist-keyboard \
      ros-humble-pointcloud-to-laserscan \
      ros-humble-foxglove-bridge ros-humble-domain-bridge \
      ros-humble-rosbag2-storage-mcap \
      ros-humble-robot-state-publisher ros-humble-xacro \
      ros-humble-tf2-ros ros-humble-tf2-tools ros-humble-tf2-msgs \
      ros-humble-launch-testing ros-humble-launch-testing-ament-cmake ros-humble-launch-testing-ros \
      ros-humble-ament-cmake-pytest ros-humble-rosidl-default-generators \
      ros-humble-rmw-cyclonedds-cpp ros-humble-diagnostic-msgs \
    && rm -rf /var/lib/apt/lists/*

# Optional binaries: availability is recorded, not assumed.
RUN apt-get update && mkdir -p /opt/ultron && : > /opt/ultron/apt_optional.txt && \
    for pkg in ros-humble-mola ros-humble-mola-lidar-odometry ros-humble-mola-state-estimation \
               ros-humble-mp2p-icp ros-humble-kiss-icp ros-humble-spatio-temporal-voxel-layer \
               ros-humble-robot-localization ros-humble-rslidar-msg ros-humble-realsense2-camera-msgs; do \
      if apt-get install -y --no-install-recommends "$pkg" >/dev/null 2>&1; then \
        echo "$pkg INSTALLED $(dpkg-query -W -f='${Version}' "$pkg")" >> /opt/ultron/apt_optional.txt; \
      else echo "$pkg UNAVAILABLE" >> /opt/ultron/apt_optional.txt; fi; \
    done && rm -rf /var/lib/apt/lists/* && cat /opt/ultron/apt_optional.txt

# Python tooling. kiss-icp pip is the fallback if the ROS binary is unavailable.
RUN python3 -m pip install --no-cache-dir rosbags==0.10.11 kiss-icp==1.2.3 \
    && python3 -m pip freeze | grep -Ei '^(rosbags|kiss-icp)==' >> /opt/ultron/pip_installed.txt

# Build deps of source-built third-party packages (deps.repos build/*): unitree_ros2 msgs.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ros-humble-rosidl-generator-dds-idl \
    && rm -rf /var/lib/apt/lists/*

RUN rosdep update --rosdistro humble || true

ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    ROS_LOCALHOST_ONLY=1 \
    ROS_DOMAIN_ID=71
# Never default to domain 0 (robot network).

RUN echo 'source /opt/ros/humble/setup.bash' >> /etc/bash.bashrc
CMD ["bash"]
