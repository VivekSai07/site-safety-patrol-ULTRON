<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ultron_b2_control</name>
  <version>0.1.0</version>
  <description>Owner: Agent D. twist_mux (HOLD > teleop > autonomy) -> collision_monitor -> motion_gate chain launch, active_source_monitor, teleop launch, sim_driver adapter, b2_sport_bridge (subscribes only cmd_vel; hardware_enable false by default; tested only against mock_sport_server).</description>
  <maintainer email="ultron@example.invalid">ULTRON team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>ultron_b2_interfaces</exec_depend>
  <exec_depend>ultron_b2_navigation</exec_depend>
  <exec_depend>unitree_api</exec_depend>
  <exec_depend>unitree_go</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
