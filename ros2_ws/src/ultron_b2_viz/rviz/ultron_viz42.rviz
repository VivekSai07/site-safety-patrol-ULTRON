# GENERATED by ultron_b2_viz.gen_configs from whitelist.py -- do not edit by hand.
# Laptop RViz on domain 42 (ROS_DOMAIN_ID=42). Topics come from domain_bridge/zenoh
# with mode-independent names under /ultron/viz. The image uses the compressed transport
# (set Transport Hint to "compressed" if your RViz does not pick it up automatically).
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Reference Frame: map
      Plane Cell Count: 40
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: false
      Marker Scale: 0.5
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Source: Topic
      Description Topic: 
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ultron/viz/robot_description
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map
      Topic: 
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ultron/viz/map
      Color Scheme: map
      Alpha: 0.7
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Global costmap
      Topic: 
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ultron/viz/global_costmap
      Color Scheme: costmap
      Alpha: 0.4
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Local costmap
      Topic: 
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ultron/viz/local_costmap
      Color Scheme: costmap
      Alpha: 0.4
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Lidar (viz, voxelized)
      Topic: 
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ultron/viz/points
      Size (m): 0.05
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: 3D map (viz)
      Topic: 
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ultron/viz/map_cloud
      Style: Points
      Size (Pixels): 1
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Scan
      Topic: 
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /ultron/viz/sensors/scan
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 64; 64
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odometry
      Topic: 
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ultron/viz/state/odom
      Keep: 20
      Shape: 
        Value: Arrow
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Plan
      Topic: 
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ultron/viz/plan
      Color: 64; 200; 64
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Head camera (JPEG)
      Topic: 
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ultron/viz/cam_head/color/image
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Focal Point:
        X: 6
        Y: 4
        Z: 0
      Name: Current View
      Pitch: 0.9
      Target Frame: map
      Yaw: -1.6
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
