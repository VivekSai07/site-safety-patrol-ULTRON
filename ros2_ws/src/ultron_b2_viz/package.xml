<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ultron_b2_viz</name>
  <version>0.1.0</version>
  <description>Agent F: viz_throttle (voxelized clouds, JPEG images, rate-limited maps/plans), foxglove_bridge whitelist + layouts, domain_bridge to viz domain 42, zenoh-bridge-ros2dds allow-list, laptop RViz config, bandwidth probes.</description>
  <maintainer email="ultron@example.invalid">ULTRON team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-websockets</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>domain_bridge</exec_depend>
  <exec_depend>ultron_b2_interfaces</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
