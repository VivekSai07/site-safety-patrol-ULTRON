<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ultron_b2_bringup</name>
  <version>0.1.0</version>
  <description>ULTRON B2 sim/replay/live launch skeleton, preflight isolation checks, TF-authority check and DDS profiles (owner: Agent A).</description>
  <maintainer email="ultron@example.invalid">ULTRON team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>tf2_msgs</depend>
  <depend>diagnostic_msgs</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ultron_b2_description</exec_depend>
  <exec_depend>ultron_b2_interfaces</exec_depend>
  <exec_depend>ultron_b2_localization</exec_depend>
  <exec_depend>ultron_b2_navigation</exec_depend>  <!-- nav sub-launch (Agent D) -->
  <exec_depend>ultron_b2_control</exec_depend>     <!-- control sub-launch (Agent D) -->
  <exec_depend>ultron_b2_perception</exec_depend>
  <exec_depend>ultron_b2_mission</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ultron_b2_sim</exec_depend>
  <exec_depend>ultron_b2_viz</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rmw_cyclonedds_cpp</exec_depend>
  <exec_depend>ultron_b2_preprocess</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>realsense2_camera_msgs</exec_depend>
  <!-- live drivers (rslidar_sdk, xsens_mti_ros2_driver, realsense2_camera) are not dependencies: not in the
       dev image, live mode is never run here; see config/drivers/ and launch/sub/drivers.launch.py. -->

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>geometry_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
