Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 20; 27; 39
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/MarkerArray
      Name: Construction site
      Enabled: true
      Marker Topic:
        Value: /ultron/sim/scene
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Unitree B2 primitives
      Enabled: true
      Marker Topic:
        Value: /ultron/sim/b2
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Ladder inspection memory
      Enabled: true
      Marker Topic:
        Value: /ultron/sim/assets
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Patrol trajectory
      Enabled: true
      Topic:
        Value: /ultron/sim/path
      Color: 70; 180; 245
      Line Width: 0.04
    - Class: rviz_default_plugins/Image
      Name: Simulated RGB
      Enabled: true
      Topic:
        Value: /ultron/sim/rgb
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Pitch: 0.65
      Yaw: 4.4
      Focal Point:
        X: 6
        Y: 4
        Z: 0.5
Window Geometry:
  Width: 1440
  Height: 900
