{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultron:synthetic-ladder-draft:v1",
  "title": "Synthetic ladder draft example",
  "description": "Independently authored demonstration fields, not an official form, inspection procedure, or mapping of any real form.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "form_id",
    "session_id",
    "ladder_id",
    "untrusted_inputs",
    "created_at",
    "field_observations",
    "inspection_history",
    "label_date_observations",
    "human_review"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "form_id": {"const": "ultron_synthetic_ladder_demo_v1"},
    "session_id": {"type": "string", "minLength": 1},
    "ladder_id": {"type": "string", "minLength": 1},
    "untrusted_inputs": {"const": true},
    "created_at": {"type": "string", "format": "date-time"},
    "field_observations": {
      "type": "object",
      "required": [
        "demo_label_text",
        "demo_overview_note",
        "demo_last_inspection_date",
        "demo_next_inspection_date",
        "demo_physical_review"
      ],
      "properties": {
        "demo_label_text": {"$ref": "#/$defs/field_observation"},
        "demo_overview_note": {"$ref": "#/$defs/field_observation"},
        "demo_last_inspection_date": {"$ref": "#/$defs/field_observation"},
        "demo_next_inspection_date": {"$ref": "#/$defs/field_observation"},
        "demo_physical_review": {"$ref": "#/$defs/human_field"}
      },
      "additionalProperties": false
    },
    "inspection_history": {
      "type": "array",
      "items": {"$ref": "#/$defs/inspection_record"}
    },
    "label_date_observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/date_observation"}
    },
    "human_review": {
      "type": "object",
      "required": ["required", "status", "reviewer", "reviewed_at", "signature"],
      "properties": {
        "required": {"const": true},
        "status": {"const": "PENDING"},
        "reviewer": {"type": "null"},
        "reviewed_at": {"type": "null"},
        "signature": {"type": "null"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["method", "producer", "recorded_at", "untrusted"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "producer": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date-time"},
        "untrusted": {"const": true}
      }
    },
    "proposal": {
      "type": "object",
      "required": ["value", "reason", "coverage", "evidence_ids", "provenance", "untrusted"],
      "properties": {
        "value": {},
        "reason": {"type": ["string", "null"]},
        "coverage": {"enum": ["OBSERVED", "OCCLUDED", "UNREADABLE", "CONFLICTING", "NOT_APPLICABLE"]},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "untrusted": {"const": true}
      },
      "additionalProperties": false
    },
    "field_observation": {
      "type": "object",
      "required": ["field_id", "source_page", "coverage", "proposals"],
      "properties": {
        "field_id": {"type": "string", "minLength": 1},
        "source_page": {"type": "integer", "minimum": 1},
        "coverage": {"enum": ["NOT_ASSESSED", "OBSERVED", "OCCLUDED", "UNREADABLE", "CONFLICTING", "NOT_APPLICABLE", "HUMAN_ONLY"]},
        "proposals": {"type": "array", "items": {"$ref": "#/$defs/proposal"}}
      },
      "additionalProperties": false
    },
    "human_field": {
      "allOf": [
        {"$ref": "#/$defs/field_observation"},
        {"properties": {"coverage": {"const": "HUMAN_ONLY"}, "proposals": {"maxItems": 0}}}
      ]
    },
    "inspection_record": {
      "type": "object",
      "required": ["inspection_id", "column_number", "source_heading", "inspection_date", "field_observations"],
      "properties": {
        "inspection_id": {"type": "string", "minLength": 1},
        "column_number": {"type": "integer", "minimum": 1, "maximum": 2},
        "source_heading": {"enum": ["Example A", "Example B"]},
        "inspection_date": {"type": ["string", "null"]},
        "field_observations": {
          "type": "object",
          "properties": {
            "demo_label_text": {"$ref": "#/$defs/field_observation"},
            "demo_overview_note": {"$ref": "#/$defs/field_observation"},
            "demo_last_inspection_date": {"$ref": "#/$defs/field_observation"},
            "demo_next_inspection_date": {"$ref": "#/$defs/field_observation"},
            "demo_physical_review": {"$ref": "#/$defs/human_field"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "date_observation": {
      "type": "object",
      "required": ["date_role", "value", "coverage", "evidence_ids", "provenance", "untrusted"],
      "properties": {
        "date_role": {"enum": ["MANUFACTURER_FINAL_CONTROL", "ACQUISITION", "RECURRING_INSPECTION", "NEXT_INSPECTION"]},
        "value": {},
        "coverage": {"enum": ["OBSERVED", "UNREADABLE", "CONFLICTING"]},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "untrusted": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "x-form-mapping": {
    "source": "Independently invented example; no source form",
    "source_language": "de",
    "source_pages": 1,
    "catalog_notice": "Synthetic example only, not an official form or inspection procedure. Page 1 is a v1 contract placeholder, not a source-page mapping.",
    "inspection_column_headings": ["Example A", "Example B"],
    "inspection_pages": [1],
    "field_catalog": [
      {
        "id": "demo_label_text",
        "page": 1,
        "group": "Demo evidence",
        "label_de": "Abgelesener Kennzeichnungstext",
        "evidence_mode": "VISUAL_LIMITED",
        "human_only": false,
        "applicability": "Transcribe only visible label text; do not infer missing characters."
      },
      {
        "id": "demo_overview_note",
        "page": 1,
        "group": "Demo evidence",
        "label_de": "Beschreibung der Übersicht",
        "evidence_mode": "VISUAL_LIMITED",
        "human_only": false
      },
      {
        "id": "demo_last_inspection_date",
        "page": 1,
        "group": "Demo dates",
        "label_de": "Zuletzt angegebenes Prüfdatum",
        "evidence_mode": "VISUAL_LIMITED",
        "human_only": false,
        "applicability": "Record only a date explicitly identified as the prior inspection.",
        "date_role": "RECURRING_INSPECTION"
      },
      {
        "id": "demo_next_inspection_date",
        "page": 1,
        "group": "Demo dates",
        "label_de": "Nächstes angegebenes Prüfdatum",
        "evidence_mode": "VISUAL_OR_HUMAN",
        "human_only": false,
        "applicability": "Record only a date explicitly identified as the next inspection; do not infer an interval.",
        "date_role": "NEXT_INSPECTION"
      },
      {
        "id": "demo_physical_review",
        "page": 1,
        "group": "Demo human review",
        "label_de": "Körperliche Prüfung durch eine Fachperson",
        "evidence_mode": "HUMAN_FUNCTIONAL",
        "human_only": true
      }
    ]
  }
}
